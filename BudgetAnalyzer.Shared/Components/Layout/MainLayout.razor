@namespace BudgetAnalyzer.Shared.Layout
@inherits LayoutComponentBase

<MudThemeProvider Theme="AppTheme"/>
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <AppBar />

    <MudMainContent>
        @Body
    </MudMainContent>
</MudLayout>

@code{
    private static MudTheme AppTheme = new MudTheme()
    {
        PaletteLight = new PaletteLight()
        {
            Primary = "#2F6690",
            Secondary = "#E8C547",
            Tertiary = "#E86A92",
        }
    };
}
