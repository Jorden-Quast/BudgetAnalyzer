@using BudgetAnalyzer.Shared.Data;
@namespace BudgetAnalyzer.Shared.Layout
@inherits SubscribedComponent

<MudAppBar Color="Color.Primary">
    <MudMenu Icon="@Icons.Material.Filled.Menu" AnchorOrigin="Origin.CenterCenter" Color="Color.Secondary">
        <MudMenuItem Icon="@Icons.Material.Filled.FileUpload" OnClick="FileUploadAsync">
            Upload App Data
        </MudMenuItem>

        <MudMenuItem Icon="@Icons.Material.Filled.FileDownload" OnClick="FileDownloadAsync">
            Download App Data
        </MudMenuItem>

        <MudMenuItem Icon="@Icons.Material.Filled.ContentCopy" OnClick="CopyAppDataAsync">
            Copy App Data to Clipboard
        </MudMenuItem>
    </MudMenu>

    <MudSpacer />

    <MudButtonGroup Variant="Variant.Text" Color="Color.Secondary">
        <MudButton OnClick="@(() => NavigateTo("/"))">Home</MudButton>
        <MudButton OnClick="@(() => NavigateTo("/income"))">Income</MudButton>
        <MudButton OnClick="@(() => NavigateTo("/settings"))">Settings</MudButton>
    </MudButtonGroup>

    <MudSpacer />

    <MudTooltip Text="App's Github">
        <MudIconButton Color="Color.Secondary" Icon="@Icons.Material.Filled.Code" Href="https://github.com/Jorden-Quast/BudgetAnalyzer" />
    </MudTooltip>
</MudAppBar>

@code{
    [Inject]
    public required NavigationManager Navigation { get; set; }

    private async Task FileUploadAsync()
    {
        string? fileText = await SystemIO.UploadJsonFile();

        if (fileText is null) return;
        AddAction(new SetAppFromJsonAction(fileText));
    }
    private async Task FileDownloadAsync() => await SystemIO.DownloadJsonFile(State);
    private async Task CopyAppDataAsync() => await SystemIO.CopyText(State.ToJson());

    private void NavigateTo(string path) => Navigation.NavigateTo(path);
}
