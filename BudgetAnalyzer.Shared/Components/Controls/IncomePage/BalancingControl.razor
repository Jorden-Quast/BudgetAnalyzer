@using BudgetAnalyzer.Shared.Data
@namespace BudgetAnalyzer.Shared.Controls
@inherits IncomePageControl

<MudTable T="BudgetCategory" Items="State.SelectedBudget.Categories" Hover="true" Elevation="0" CustomFooter="true">
    <ToolBarContent>
        <MudNumericField Label="Bank Account Balance" Step="50" Immediate="true" 
        @bind-Value:get=BankBalance @bind-Value:set="SetBalance"
        Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.AttachMoney" />
    </ToolBarContent>

    <HeaderContent>
        <MudTh>Name</MudTh>
        <MudTh>Current Balance</MudTh>
    </HeaderContent>

    <RowTemplate>
        <MudTd DataLabel="Name">@context.Name</MudTd>
        <MudTd DataLabel="Current Balance">
            <MudNumericField T="decimal" Step="50" Immediate="true" 
            @bind-Value:get=@CategoryBalances[context.Id] @bind-Value:set=@((decimal newValue) => SetCategoryBalance(newValue, context.Id))/>
        </MudTd>
    </RowTemplate>

    <FooterContent>
        <MudTFootRow>
            <MudTd Style="font-weight: 500;">Total</MudTd>
            <MudTd Style="font-weight: 500;">@CategoryBalances.Sum(p => p.Value).ToString("C")</MudTd>
        </MudTFootRow>
    </FooterContent>
</MudTable>


<MudStack Row="true" AlignItems="AlignItems.Center" Class="pt-4">
    <MudText Style="font-weight: 800;">@GetRecommendation()</MudText>
    <MudSpacer />

    <MudButton Color="Color.Tertiary" OnClick="SetControlToDefault">Reset</MudButton> 
</MudStack>

@code {
    private decimal BankBalance => State.IncomeState.BankAccountBalance;
    private IReadOnlyDictionary<Guid, decimal> CategoryBalances => State.IncomeState.CategoryBalances;

    private string GetRecommendation()
    {
        decimal difference = BankBalance - CategoryBalances.Sum(p => p.Value);
        if (difference == 0)
            return "The budget is balanced";

        string displayDifference = Math.Abs(difference).ToString("C");
        string action = difference >= 0 ? $"add {displayDifference} to" : $"remove {displayDifference} from";
        return $"The budget is not balanced, {action} the budget";
    }

    private void SetBalance(decimal newValue) => AddAction(new SetIncomeStateAction(State.IncomeState with { BankAccountBalance = newValue }));

    protected override void SetControlToDefault()
    {
        IncomeState resetState = State.IncomeState with { StandardIncome = 0,
                                                          CategoryBalances = State.SelectedBudget.Categories.ToDictionary(c => c.Id, c => 0M) 
                                                        };
        AddAction(new SetIncomeStateAction(resetState));
    }
}
